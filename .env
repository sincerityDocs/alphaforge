# AlphaForge .env Configuration
# Copy this file to .env and fill in your keys

# LLM Providers (choose one or more)
GROK_API_KEY=your_grok_api_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Search / Web Tools
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_key_here

# Crypto / On-chain APIs (recommended)
DEXSCREENER_API_KEY=your_dexscreener_key_if_needed
BIRDEYE_API_KEY=your_birdeye_key_here

# Social / Monitoring
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Wallet / Execution (EXTREMELY CAREFUL - never commit this)
SOLANA_PRIVATE_KEY=your_solana_wallet_private_key_for_trading  # Use a small dedicated wallet only

# General Settings
TRADING_MODE=paper  # paper or live
MAX_POSITION_SIZE_USD=100

# For CrewAI
CREWAI_API_KEY=your_crewai_cloud_key_if_using_cloud
